# --- Data (large, regenerable; never commit) ---
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Keep run manifests if you want a record of what was pulled
!data/raw/_manifests/

# --- Model artifacts ---
checkpoints/
models/
*.pt
*.pth
*.safetensors
*.gguf
*.ckpt
wandb/
runs/
lightning_logs/

# --- Credentials and local config ---
.env
.env.*
*.pem
*.key
*service-account*.json
*credentials*.json
config/*.local.yaml

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db